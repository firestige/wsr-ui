server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location = /api/evolution/v1/evaluations:compute {
        if ($request_method != POST) { return 405; }
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_connect_timeout 2s;
        proxy_read_timeout 123s;
        proxy_send_timeout 123s;
        proxy_pass http://${EVOLUTION_UPSTREAM};
    }

    location = /v1/evidence/tasks {
        if ($request_method != GET) { return 405; }
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_connect_timeout 2s;
        proxy_pass http://${EVIDENCE_UPSTREAM};
    }

    location = /v1/evidence/facts {
        if ($request_method != GET) { return 405; }
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_connect_timeout 2s;
        proxy_pass http://${EVIDENCE_UPSTREAM};
    }

    location = /v1/evidence/traces {
        if ($request_method != GET) { return 405; }
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_connect_timeout 2s;
        proxy_pass http://${EVIDENCE_UPSTREAM};
    }

    location = /api {
        default_type application/json;
        return 404 '{"error":{"code":"ROUTE_NOT_FOUND","message":"route is not available"}}';
    }

    location = /v1/evidence {
        default_type application/json;
        return 404 '{"error":{"code":"ROUTE_NOT_FOUND","message":"route is not available"}}';
    }

    location /api/ {
        default_type application/json;
        return 404 '{"error":{"code":"ROUTE_NOT_FOUND","message":"route is not available"}}';
    }

    location /v1/evidence/ {
        default_type application/json;
        return 404 '{"error":{"code":"ROUTE_NOT_FOUND","message":"route is not available"}}';
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
